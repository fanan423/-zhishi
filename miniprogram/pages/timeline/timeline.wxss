/* 时间轴页 —— 数字安农风格（跟随主题变量） */

/* ---- 知时指数卡 ---- */
.idxcard {
  background: linear-gradient(160deg, var(--brand-2), var(--brand));
  border-radius: 24rpx;
  padding: 30rpx 30rpx 26rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 101, 62, 0.24);
}
/* 高指数时改用朝阳橙红渐变，制造视觉紧迫感 */
.idxcard.lv-high {
  background: linear-gradient(160deg, #F08A4B, var(--alert));
  box-shadow: 0 8rpx 24rpx rgba(231, 120, 68, 0.28);
}
.idxcard.lv-mid {
  background: linear-gradient(160deg, #E8A317, var(--gold));
  box-shadow: 0 8rpx 24rpx rgba(243, 174, 0, 0.26);
}
.idxr1 {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.idxl { font-size: 24rpx; color: rgba(255, 255, 255, 0.82); letter-spacing: 1rpx; }
.idxs {
  font-size: 76rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
  letter-spacing: -2rpx;
}
.idxmsg {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 10rpx;
}
.idxmetrics {
  display: flex;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}
.idxmetrics .im {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.idxmetrics .imn {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.idxmetrics .iml {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 2rpx;
}

/* ---- 分组标题 ---- */
.bk { margin-bottom: 8rpx; }
.bhd {
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow);
}
.bdot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-right: 18rpx;
  flex-shrink: 0;
}
.bhd.now .bdot { background: var(--alert); box-shadow: 0 0 0 6rpx rgba(231, 120, 68, 0.16); }
.bhd.hot .bdot { background: var(--alert); box-shadow: 0 0 0 6rpx rgba(231, 120, 68, 0.10); }
.bhd.soon .bdot { background: var(--gold); box-shadow: 0 0 0 6rpx rgba(243, 174, 0, 0.14); }
.bhd.plan .bdot { background: var(--brand-2); }
.bhd.far .bdot { background: var(--txt-3); box-shadow: none; }

.bmid { flex: 1; min-width: 0; }
.bname { font-size: 28rpx; font-weight: 600; color: var(--txt); }
.bnum { font-size: 20rpx; color: var(--txt-3); margin-top: 2rpx; }
.barrow { font-size: 24rpx; color: var(--txt-3); flex-shrink: 0; }

/* ---- 时间轴主体 ---- */
.tl {
  position: relative;
  padding-left: 34rpx;
  margin-bottom: 10rpx;
}
/* 竖线 */
.tline {
  position: absolute;
  left: 8rpx;
  top: 14rpx;
  bottom: 14rpx;
  width: 2rpx;
  background: var(--border);
}
.titem {
  position: relative;
  margin-bottom: 16rpx;
}
/* 节点圆点 */
.tnode {
  position: absolute;
  left: -32rpx;
  top: 26rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand);
  border: 4rpx solid var(--surface);
  box-sizing: content-box;
}
.tnode.hi { background: var(--alert); }
.tnode.md { background: var(--gold); }
.tnode.lo { background: var(--brand); }

.tcard {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  box-shadow: var(--card-shadow);
}
.tcard.hi { border-left: 6rpx solid var(--alert); }
.tcard.md { border-left: 6rpx solid var(--gold); }
.tcard.lo { border-left: 6rpx solid var(--brand); }

.tr1 {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}
.tr1 .tt {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--txt);
}
.tr1 .dd {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  white-space: nowrap;
  flex-shrink: 0;
  color: var(--brand);
  background: var(--brand-soft);
}
.tr1 .dd.hi { color: #FFFFFF; background: var(--alert); }
.tr1 .dd.md { color: var(--gold-ink); background: var(--gold-soft); }

.tcard .sr { font-size: 21rpx; color: var(--txt-3); margin-top: 8rpx; }
.tcard .d1 {
  font-size: 24rpx;
  color: var(--txt-2);
  line-height: 1.6;
  margin-top: 10rpx;
}
.tcard .tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.tcard .tg {
  font-size: 20rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  color: var(--txt-3);
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tcard .tg.g { color: var(--brand); background: var(--brand-soft); border-color: transparent; }
.tcard .tg.o { color: var(--gold-ink); background: var(--gold-soft); border-color: transparent; }

/* ---- 空态按钮 ---- */
.ebtn {
  display: inline-block;
  margin-top: 24rpx;
  font-size: 25rpx;
  color: var(--on-brand);
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  border-radius: 14rpx;
  padding: 14rpx 36rpx;
  font-weight: 600;
}
