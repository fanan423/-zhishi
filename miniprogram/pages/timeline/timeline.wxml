<view class="screen theme-{{theme}}">
<view class="wrap">

  <!-- 顶部指数卡 -->
  <view class="idxcard lv-{{index.level}}">
    <view class="idxr1">
      <view class="idxl">今日知时指数</view>
      <view class="idxs">{{index.score}}</view>
    </view>
    <view class="idxmsg">{{index.label}}</view>
    <view class="idxmetrics">
      <view class="im"><text class="imn">{{index.d3}}</text><text class="iml">三天内</text></view>
      <view class="im"><text class="imn">{{index.week}}</text><text class="iml">一周内</text></view>
      <view class="im"><text class="imn">{{total}}</text><text class="iml">关注总量</text></view>
    </view>
  </view>

  <block wx:if="{{hasAny}}">
    <view class="sec">按截止日排 · 共 {{total}} 条<text class="secsub">· 点分组标题可折叠</text></view>

    <view class="bk" wx:for="{{buckets}}" wx:for-item="b" wx:key="key">
      <block wx:if="{{b.count > 0}}">

        <view class="bhd {{b.cls}}" data-k="{{b.key}}" bindtap="toggleBucket">
          <text class="bdot"></text>
          <view class="bmid">
            <view class="bname">{{b.label}}</view>
            <view class="bnum">{{b.count}} 条</view>
          </view>
          <text class="barrow">{{openKeys.indexOf(b.key) >= 0 ? '▾' : '▸'}}</text>
        </view>

        <block wx:if="{{openKeys.indexOf(b.key) >= 0}}">
          <view class="tl">
            <view class="tline"></view>
            <view class="titem" wx:for="{{b.items}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
              <view class="tnode {{item.level}}"></view>
              <view class="tcard {{item.level}}">
                <view class="tr1">
                  <view class="tt">{{item.title}}</view>
                  <view class="dd {{item.level}}">
                    {{item.countdown === 0 ? '今天' : (item.countdown < 0 ? '已过期' : 'D-' + item.countdown)}}
                  </view>
                </view>
                <view class="sr">{{item.icon}} {{item.event}} · {{item.source}}</view>
                <view class="d1" wx:if="{{item.digestOne}}">{{item.digestOne}}</view>
                <view class="tags">
                  <text class="tg">截止 {{item.deadline}}</text>
                  <text class="tg g" wx:if="{{item.real && item.url}}">✓ 可核对原文</text>
                  <text class="tg o" wx:if="{{item.real && !item.url}}">真实采集</text>
                  <text class="tg o" wx:if="{{item.entry}}">{{item.entry}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>

      </block>
    </view>
  </block>

  <!-- 空态 -->
  <view class="empty" wx:else>
    <view>日程还是空的</view>
    <view style="margin-top:10rpx">说明你关注的范围里，最近没有需要盯截止日期的事</view>
    <view class="ebtn" bindtap="goMe">去调整我的订阅 ›</view>
  </view>

  <view class="foot">
    <view><text class="hl">怎么读这张图：</text>纵轴是「离截止还有多久」，越靠上越急。每张卡都链到详情，可核对原文。</view>
    <view style="margin-top:8rpx">日程只呈现你自己勾选关注的通知，不含任何私域数据。</view>
  </view>

</view>
</view>
