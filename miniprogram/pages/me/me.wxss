/* 订阅设置页 —— 数字安农风格（跟随主题变量） */

/* 运行模式提示条 */
.modebar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--txt-2);
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 26rpx;
  line-height: 1.5;
}
.modebar.on {
  color: var(--brand);
  border-color: rgba(0, 101, 62, 0.30);
  background: var(--brand-soft);
}
.mdot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--txt-3);
}
.modebar.on .mdot {
  background: var(--brand-2);
  box-shadow: 0 0 10rpx rgba(10, 122, 76, 0.6);
}

/* ============================================================
 * ★ 智能体服务卡
 * 三态用左边框 + 状态点颜色区分：绿=连上 / 灰=本地 / 橙=配了没连上
 * ============================================================ */
.agbox {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-left: 6rpx solid var(--txt-3);
  border-radius: 16rpx;
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 8rpx;
  box-shadow: var(--shadow);
}
.agbox.on   { border-left-color: #17A05A; background: linear-gradient(180deg, rgba(23,160,90,0.05), var(--surface)); }
.agbox.warn { border-left-color: #E08A16; background: linear-gradient(180deg, rgba(224,138,22,0.06), var(--surface)); }
.agbox.off  { border-left-color: var(--txt-3); }

.agr1 { display: flex; align-items: flex-start; }
.agdot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  margin: 8rpx 14rpx 0 0;
  flex-shrink: 0;
  background: var(--txt-3);
}
.agbox.on   .agdot { background: #17A05A; box-shadow: 0 0 0 6rpx rgba(23,160,90,0.16); }
.agbox.warn .agdot { background: #E08A16; box-shadow: 0 0 0 6rpx rgba(224,138,22,0.16); }

.agrl { flex: 1; }
.aglabel {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--txt-1);
  line-height: 1.45;
}
.agbox.on .aglabel { color: #17A05A; }
.agbox.warn .aglabel { color: var(--gold-ink); }
.agsub {
  font-size: 21rpx;
  color: var(--txt-3);
  margin-top: 7rpx;
  line-height: 1.6;
  word-break: break-all;
}
.agsub.warn { color: var(--gold-ink); }

.agacts {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}
.agbtn {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  color: var(--brand);
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 16rpx 0;
}
.agbtn.primary {
  color: var(--on-brand);
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  border-color: transparent;
  font-weight: 600;
}

.agcfg { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx dashed var(--border); }
.agin {
  width: 100%;
  box-sizing: border-box;
  font-size: 24rpx;
  color: var(--txt-1);
  background: var(--surface-2, var(--surface));
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}
.agcfgtip {
  font-size: 20rpx;
  color: var(--txt-3);
  line-height: 1.65;
  margin-top: 12rpx;
}

/* 主题切换按钮（页头） */
.tbtn {
  font-size: 21rpx;
  color: var(--brand);
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
  flex-shrink: 0;
  font-weight: 500;
}

/* 概览卡 */
.ovc {
  background: linear-gradient(135deg, var(--brand-soft), var(--gold-soft));
  border: 1rpx solid rgba(0, 101, 62, 0.24);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 8rpx;
}
.ovl { font-size: 22rpx; color: var(--txt-2); }
.ovn { font-size: 52rpx; font-weight: 700; color: var(--brand); margin: 6rpx 0 4rpx; }
.ovu { font-size: 24rpx; color: var(--txt-2); font-weight: 400; margin-left: 8rpx; }
.ovs { font-size: 22rpx; color: var(--txt-2); }
.ovhl { color: var(--brand); font-weight: 600; }

/* 快捷入口（日程 / 汇总） */
.quick {
  display: flex;
  gap: 16rpx;
  margin: 18rpx 0 8rpx;
}
.qb {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  padding: 24rpx 0;
  box-shadow: var(--shadow);
}
.qbi { font-size: 30rpx; }
.qbt { font-size: 25rpx; font-weight: 600; color: var(--txt); }

/* 身份未完成提示 */
.idtip {
  font-size: 22rpx;
  color: var(--gold-ink);
  padding: 18rpx 0 6rpx;
  line-height: 1.5;
}

.box {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  padding: 4rpx 24rpx;
  margin-bottom: 8rpx;
  box-shadow: var(--shadow);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}
.row:last-child { border-bottom: none; }
.rk { font-size: 26rpx; color: var(--txt-2); flex-shrink: 0; }
.rv {
  font-size: 26rpx;
  text-align: right;
  max-width: 62%;
  color: var(--txt);
}
.arrow { color: var(--brand); margin-left: 6rpx; }

.secsub { font-size: 20rpx; color: var(--txt-3); font-weight: 400; }
.rin {
  flex: 1;
  margin-left: 24rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--txt);
}
.idsum {
  font-size: 21rpx;
  color: var(--brand);
  padding: 18rpx 0 20rpx;
  font-weight: 500;
}

/* 关注事项 chips */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 0 16rpx;
}
.chip {
  font-size: 25rpx;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  color: var(--txt-2);
}
.chip.on {
  background: var(--brand-soft);
  border-color: var(--brand);
  color: var(--brand);
  font-weight: 600;
}
.cnum {
  font-size: 19rpx;
  margin-left: 8rpx;
  opacity: 0.65;
}

/* 快捷操作 */
.cops {
  display: flex;
  gap: 26rpx;
  padding-bottom: 8rpx;
}
.cop {
  font-size: 22rpx;
  color: var(--brand);
  font-weight: 500;
}

.hint {
  font-size: 21rpx;
  color: var(--txt-3);
  padding-bottom: 20rpx;
}
.hint .reach { color: var(--brand); font-weight: 700; }
.hint .reachw { color: var(--alert); }

/* ---- 我的关键词（自定义订阅） ---- */
.kwlead {
  font-size: 21rpx;
  color: var(--txt-3);
  line-height: 1.6;
  padding: 22rpx 0 4rpx;
}
.kwin {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0 12rpx;
}
.kwinbox {
  flex: 1;
  height: 64rpx;
  padding: 0 22rpx;
  font-size: 25rpx;
  color: var(--txt);
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
}
.kwadd {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--txt-3);
  background: var(--border-soft);
  padding: 14rpx 30rpx;
  border-radius: 32rpx;
}
.kwadd.on {
  color: #fff;
  background: var(--brand);
}
.kwchips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 8rpx 0 12rpx;
}
.kwchip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  padding: 10rpx 8rpx 10rpx 20rpx;
  border-radius: 28rpx;
  background: var(--brand-soft);
  border: 1rpx solid var(--brand);
  color: var(--brand);
}
.kwchip.empty {
  background: var(--surface);
  border-color: var(--border);
  color: var(--txt-3);
}
.kwchip-t { font-weight: 600; }
.kwchip-n { font-size: 19rpx; opacity: 0.7; }
.kwchip-n.empty { opacity: 0.85; }
.kwchip-hot {
  font-size: 18rpx;
  color: #fff;
  background: var(--alert);
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}
.kwchip-x {
  font-size: 28rpx;
  line-height: 1;
  padding: 0 12rpx 0 6rpx;
  opacity: 0.55;
}
.kwsug {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  padding: 4rpx 0 14rpx;
}
.kwsug-l { font-size: 21rpx; color: var(--txt-3); }
.kwsug-w {
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-soft);
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}

/* 收藏列表 */
.frow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}
.frow:last-child { border-bottom: none; }
.fmid { flex: 1; min-width: 0; }
.ft {
  font-size: 26rpx;
  color: var(--txt);
  line-height: 1.4;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.fs { font-size: 20rpx; color: var(--txt-3); margin-top: 6rpx; }
.fdd {
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--gold-ink);
  background: var(--gold-soft);
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
}
.fdd.exp {
  color: var(--txt-3);
  background: rgba(147, 160, 150, 0.13);
}

/* ============ 收藏行：紧急度色阶 + 办事进度 ============ */
.frow.lv-exp  { border-left-color: var(--txt-3); }
.frow.lv-now  { border-left-color: var(--alert); }
.frow.lv-hot  { border-left-color: var(--alert); }
.frow.lv-soon { border-left-color: var(--gold); }
.frow.lv-far  { border-left-color: var(--brand); }
.frow {
  border-left: 6rpx solid transparent;
  padding-left: 16rpx;
}

.fdd.lv-now  { color: var(--alert-ink); background: var(--alert-soft); }
.fdd.lv-hot  { color: var(--alert-ink); background: var(--alert-soft); }
.fdd.lv-soon { color: var(--gold-ink); background: var(--gold-soft); }
.fdd.lv-far  { color: var(--brand); background: var(--brand-soft); }
.fdd.lv-exp  { color: var(--txt-3); background: rgba(147, 160, 150, 0.13); }

.fprog {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 10rpx;
}
.fpi { font-size: 20rpx; color: var(--txt-2); }
.fpi.ok { color: var(--brand); font-weight: 600; }
.fplink { font-size: 20rpx; color: var(--brand); font-weight: 600; }

.secwarn {
  font-size: 20rpx; color: var(--alert-ink); font-weight: 600;
  background: var(--alert-soft); padding: 2rpx 12rpx;
  border-radius: 999rpx; margin-left: 12rpx;
}

.favhint {
  font-size: 20rpx; color: var(--txt-3); line-height: 1.6;
  margin-top: 12rpx;
}

/* ============ 已删除行：可找回 ============ */
.hrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}
.hrow:last-child { border-bottom: none; }
.hmid { flex: 1; min-width: 0; }
.hrow .ft { color: var(--txt-3); }
.hbtn {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand-ink, var(--brand));
  background: var(--brand-soft, rgba(0, 101, 62, 0.1));
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

/* 边界说明 */
.note {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-left: 8rpx solid var(--gold);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin: 26rpx 0 8rpx;
}
.nt1 {
  font-size: 24rpx;
  color: var(--gold-ink);
  font-weight: 600;
  margin-bottom: 12rpx;
}
.nl {
  font-size: 23rpx;
  color: var(--txt-2);
  line-height: 1.9;
}
.nl.no { color: var(--alert); }

/* 数据自查入口 */
.scbox {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-left: 8rpx solid var(--brand);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 8rpx;
  box-shadow: var(--shadow);
}
.scbox .scic {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 56rpx;
  font-size: 28rpx;
  background: var(--brand-soft);
}
.scbox .scbd { flex: 1; min-width: 0; }
.scbox .sct {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--txt);
}
.scbox .scd {
  font-size: 21rpx;
  color: var(--txt-2);
  line-height: 1.6;
  margin-top: 6rpx;
}
.scbox .scar {
  flex-shrink: 0;
  font-size: 34rpx;
  color: var(--brand);
}

/* 操作 */
.acts {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 26rpx;
}
.ab {
  font-size: 27rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 20rpx 0;
  background: var(--surface);
  color: var(--txt);
  border: 1rpx solid var(--border);
  line-height: 1.2;
}
.ab::after { border: none; }
.ab.primary {
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  color: var(--on-brand);
  border: none;
}
.ab.dis {
  background: var(--border-soft);
  color: var(--txt-3);
  border: 1rpx solid var(--border);
}

/* ============ ★ 微信服务通知（订阅页入口） ============ */
.wxrow {
  align-items: center;
}
.wxrowl { flex: 1; min-width: 0; }
.wxrows { font-size: 22rpx; margin-top: 6rpx; }
.wxrows.off { color: var(--txt-3); }
.wxrows.demo { color: #C77700; }
.wxrows.real { color: var(--brand); }
.wxbtn {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--brand);
  background: transparent;
  color: var(--brand);
  margin: 0;
}
.wxbtn::after { border: none; }
.wxbtn.on {
  background: rgba(0, 101, 62, 0.08);
}
.wxbtn[disabled] { opacity: 0.55; }
.wxrowtip {
  font-size: 21rpx;
  color: var(--txt-3);
  line-height: 1.6;
  padding: 6rpx 0 4rpx;
}
