/* 今日简报页 —— 数字安农风格（跟随主题变量） */

/* ---- 简报头 ---- */
.bhead {
  display: flex;
  align-items: center;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 26rpx;
}
.bhead .lg {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  box-shadow: 0 4rpx 12rpx rgba(0, 101, 62, 0.22);
  margin-right: 18rpx;
  flex-shrink: 0;
}
.bhead .lg::before {
  content: '';
  position: absolute;
  top: 4rpx; left: 4rpx; right: 4rpx; bottom: 4rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  z-index: 2;
}
.bhead .lg::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 26rpx;
  background: repeating-linear-gradient(90deg, rgba(255,255,255,0.22) 0 4rpx, transparent 4rpx 9rpx);
  border-top: 2rpx solid rgba(255, 255, 255, 0.30);
}
.bhead .lg .sun {
  position: absolute;
  top: 10rpx; right: 12rpx;
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: var(--gold);
}
.bhead .lg .aa {
  position: absolute;
  left: 0; right: 0; top: 14rpx;
  text-align: center;
  z-index: 1;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.bhead .lg .book {
  position: absolute;
  left: 50%; top: 42rpx;
  transform: translateX(-50%);
  width: 30rpx; height: 4rpx;
  border-radius: 0 0 4rpx 4rpx;
  background: rgba(255, 255, 255, 0.5);
  z-index: 2;
}
.bhead .lg .y {
  position: absolute;
  left: 0; right: 0; top: 47rpx;
  z-index: 3;
  text-align: center;
  font-size: 13rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 1rpx;
}
.bhead .bx { flex: 1; min-width: 0; }
.bhead .t1 { font-size: 32rpx; font-weight: 600; color: var(--txt); }
.bhead .t2 { font-size: 21rpx; color: var(--txt-2); margin-top: 2rpx; }

/* ---- 一句话总结卡 ---- */
.sumcard {
  background: linear-gradient(160deg, var(--brand-2), var(--brand));
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 101, 62, 0.22);
}
.sumcard.lv-high {
  background: linear-gradient(160deg, #F08A4B, var(--alert));
  box-shadow: 0 8rpx 24rpx rgba(231, 120, 68, 0.26);
}
.sumcard.lv-mid {
  background: linear-gradient(160deg, #E8A317, var(--gold));
  box-shadow: 0 8rpx 24rpx rgba(243, 174, 0, 0.24);
}
.sumlb {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}
.sumtx {
  font-size: 30rpx;
  color: #FFFFFF;
  line-height: 1.6;
  font-weight: 500;
}
.sumidx {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}
.sumidx .sin { font-size: 21rpx; color: rgba(255, 255, 255, 0.78); }
.sumidx .siv {
  font-size: 42rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}
.sumidx .sil { font-size: 22rpx; color: rgba(255, 255, 255, 0.9); }

/* ---- 要办卡片 ---- */
.icard {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--card-shadow);
}
.icard.now { border-left: 8rpx solid var(--alert); background: var(--alert-soft); }
.icard.hi { border-left: 8rpx solid var(--alert); }
.ir1 {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}
.ir1 .it {
  flex: 1;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--txt);
}
.ir1 .idd {
  font-size: 23rpx;
  font-weight: 700;
  padding: 5rpx 16rpx;
  border-radius: 10rpx;
  white-space: nowrap;
  flex-shrink: 0;
  color: #FFFFFF;
  background: var(--alert);
}
.icard .isr { font-size: 21rpx; color: var(--txt-3); margin-top: 8rpx; }
.icard .ione {
  font-size: 25rpx;
  color: var(--txt-2);
  line-height: 1.6;
  margin-top: 12rpx;
}
.icard .ientry {
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 10rpx;
  padding: 10rpx 16rpx;
  margin-top: 14rpx;
  line-height: 1.5;
}

/* ---- 留意卡片 ---- */
.wcard {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-left: 6rpx solid var(--gold);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  box-shadow: var(--card-shadow);
}
.wr1 {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}
.wr1 .wt {
  flex: 1;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.45;
  color: var(--txt);
}
.wr1 .wdd {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--gold-ink);
  background: var(--gold-soft);
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.wcard .wsr { font-size: 21rpx; color: var(--txt-3); margin-top: 8rpx; }

/* ---- 可信度 ---- */
.trust {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 8rpx;
  box-shadow: var(--shadow);
}
.tr1 {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 14rpx;
}
.trl { font-size: 25rpx; color: var(--txt); font-weight: 500; }
.trv { font-size: 26rpx; font-weight: 700; color: var(--brand); }
.trbar {
  height: 14rpx;
  border-radius: 7rpx;
  background: var(--border-soft);
  overflow: hidden;
}
.trfill {
  height: 100%;
  border-radius: 7rpx;
  background: linear-gradient(90deg, var(--gold), var(--brand));
}
.trust-high .trfill { background: linear-gradient(90deg, var(--brand-2), var(--brand)); }
.trust-mid .trfill { background: linear-gradient(90deg, var(--gold), var(--brand)); }
.trust-low .trfill { background: var(--txt-3); }
.trust-high .trv { color: var(--brand); }
.trust-mid .trv { color: var(--gold-ink); }
.trust-low .trv { color: var(--txt-2); }
.trmsg {
  font-size: 23rpx;
  color: var(--txt-2);
  margin-top: 14rpx;
}
.trsub {
  font-size: 21rpx;
  color: var(--txt-3);
  margin-top: 8rpx;
  line-height: 1.6;
}
/* 出处说明：把"有没有链接"讲清楚，避免把采集到的标题当权威原文 */
.trnote {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--border);
  font-size: 20rpx;
}

/* ============================================================
 * ★ 智能体主动送达区块
 * ------------------------------------------------------------
 * 视觉上要和上面「本地简报」明确区分开 —— 这不是一回事：
 *   上面 = 你打开小程序时本地现算（浅色、圆角小）
 *   下面 = 服务端智能体常驻跑出来（左侧竖条 + 状态点，更像"终端输出"）
 * 状态点颜色是诚实标识：绿=连上了服务端 / 灰=本地模式 / 橙=配了却没连上
 * ============================================================ */
.agent {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-left: 6rpx solid var(--brand);
  border-radius: 18rpx;
  padding: 22rpx 22rpx 18rpx;
  box-shadow: var(--shadow);
  margin-bottom: 8rpx;
}

/* 状态条 */
.aghead {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed var(--border);
}
.agdot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
  background: var(--txt-3);
}
.agdot-remote { background: #17A05A; box-shadow: 0 0 0 5rpx rgba(23, 160, 90, 0.16); }
.agdot-local  { background: var(--txt-3); }
.agdot.warn   { background: #E08A16; box-shadow: 0 0 0 5rpx rgba(224, 138, 22, 0.16); }
.aglab {
  flex: 1;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--txt-1);
}
.agvia {
  font-size: 20rpx;
  color: var(--txt-3);
  background: var(--chip, rgba(0,101,62,0.07));
  border-radius: 10rpx;
  padding: 5rpx 14rpx;
}

/* 降级/错误提示：必须显眼，不能藏 */
.agwarn {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--gold-ink);
  background: rgba(224, 138, 22, 0.09);
  border: 1rpx solid rgba(224, 138, 22, 0.28);
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
}
.agwarnr { display: block; margin-top: 6rpx; font-size: 20rpx; color: var(--txt-3); }

.agloading {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: var(--txt-3);
  text-align: center;
  padding: 26rpx 0;
}

/* 分组小标题 */
.agtl, .agsl {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--txt-2);
  margin: 20rpx 0 12rpx;
}
.agsl { color: var(--txt-3); font-weight: 400; }

/* 主动送达卡（要打断你的，视觉最重） */
.agnotify {
  background: linear-gradient(180deg, rgba(0,101,62,0.05), rgba(0,101,62,0.01));
  border: 1rpx solid rgba(0, 101, 62, 0.16);
  border-radius: 14rpx;
  padding: 18rpx 18rpx 14rpx;
  margin-bottom: 14rpx;
}
.agnr1 { display: flex; align-items: flex-start; }
.agnt {
  flex: 1;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--txt-1);
  line-height: 1.5;
  margin-right: 14rpx;
}
.agnd {
  font-size: 21rpx;
  font-weight: 600;
  color: var(--on-brand);
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  border-radius: 9rpx;
  padding: 5rpx 13rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.agnsr {
  font-size: 21rpx;
  color: var(--txt-3);
  margin-top: 9rpx;
}
.agnrs {
  font-size: 22rpx;
  color: var(--brand);
  margin-top: 10rpx;
  line-height: 1.55;
  background: rgba(0, 101, 62, 0.06);
  border-radius: 9rpx;
  padding: 9rpx 13rpx;
}
.agnone {
  font-size: 22rpx;
  color: var(--txt-2);
  line-height: 1.6;
  margin-top: 10rpx;
}

/* 静默进流（不打扰，视觉最轻） */
.agsitem {
  display: flex;
  align-items: center;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid var(--border);
}
.agsitem:last-child { border-bottom: none; }
.agst {
  flex: 1;
  font-size: 23rpx;
  color: var(--txt-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 14rpx;
}
.agsd { font-size: 20rpx; color: var(--txt-3); flex-shrink: 0; }

.agem {
  text-align: center;
  font-size: 23rpx;
  color: var(--txt-3);
  padding: 34rpx 0;
}

/* 元信息：可核对的"它怎么算的" */
.agmeta {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--border);
  font-size: 19rpx;
  color: var(--txt-3);
  line-height: 1.85;
}
.agmeta text { display: block; }

.agacts {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}
.agbtn {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  color: var(--brand);
  background: var(--surface-2, var(--surface));
  border: 1rpx solid var(--border);
  border-radius: 13rpx;
  padding: 18rpx 0;
}

/* ---- 快捷入口 ---- */
.quick {
  display: flex;
  gap: 14rpx;
  margin: 24rpx 0 8rpx;
}
.qbtn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--brand);
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 22rpx 0;
  box-shadow: var(--shadow);
}

/* ---- 按钮 ---- */
.acts { margin-top: 24rpx; }

/* ---- 空态 ---- */
.empty {
  text-align: center;
  color: var(--txt-3);
  font-size: 26rpx;
  padding: 70rpx 20rpx;
}
.ebtn {
  display: inline-block;
  margin-top: 24rpx;
  font-size: 25rpx;
  color: var(--on-brand);
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  border-radius: 14rpx;
  padding: 14rpx 36rpx;
  font-weight: 600;
}
