{
  "_comment": "知时 · 信息源注册表（可插拔）。每个源声明：怎么取列表、怎么取详情、怎么归类。新增源只改本文件或加一个 adapter 名，不改采集器主流程。",
  "_schema_version": "1.1",
  "_policy": "仅采集公网公开通知页；不涉及教务后台、不涉及任何登录态系统。",

  "adapters": {
    "ahau_vsb": {
      "_doc": "安农 Visual SiteBuilder 模板（www/jwc/xgb/gxy/jgxy/lib/gh/bwc/rsc/xxb 等绝大多数二级站都是这套）。列表页 a[href] 命中 /info/<栏目>/<文章>.htm；详情正文在 div.content / div.v_news_content。",
      "list_selector": "a[href]",
      "detail_link_regex": "(?:^|/)info/(\\d+)/(\\d+)\\.htm",
      "content_selectors": ["div.v_news_content", "div.content", "div#content", "div.article", "div.main", "form", "body"],
      "date_in_parent": true
    },
    "generic": {
      "_doc": "通用兜底适配器：任何静态通知列表页。只按相对链接解析，不依赖特定栏目路径。",
      "list_selector": "a[href]",
      "detail_link_regex": "(?:^|/)info/\\d+/\\d+\\.htm|(?:^|/)content/\\d+",
      "content_selectors": ["article", "div.content", "div.article", "main", "body"],
      "date_in_parent": true
    }
  },

